APP_ENV=development
DATABASE_URL=postgresql+psycopg://eu_funding:eu_funding@localhost:5432/eu_funding
DATABASE_HEALTH_TIMEOUT_SECONDS=2
# Optional; defaults to DATABASE_URL when empty.
CHECKPOINT_DATABASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_MAX_INPUT_CHARS=120000
# Optional verified local snapshot; otherwise the fixed Hugging Face revision is used.
RERANKER_MODEL_PATH=
CORDIS_API_KEY=
CALL_REFRESH_HOURS=24
